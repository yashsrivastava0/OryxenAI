# ============================================================================
# OryxenAI secrets (TEMPLATE).
# Copy this file to ".env" and fill in real credential VALUES only.
# Never commit ".env". This file contains no real credentials.
#
# Non-secret application configuration lives in committed files:
#   config/app.toml      -> [app] and [database] settings
#   config/models.toml  -> provider-neutral model profiles
#
# Secrets belong here, along with small VM-local coordinates that must not be
# committed with a real deployment.
# ============================================================================

# PostgreSQL password for the application database user.
POSTGRES_PASSWORD=oryxenlocal

# --- Optional provider/model API keys ---
# Active real model operations use the environment variable named by their
# profile's api_key_env. The committed default is Anthropic. The app, worker,
# and normal tests (deterministic mock model client) do not require a model key.
# Profiles in config/models.toml reference these by NAME via api_key_env.
# Keep provider keys available for profiles that may be enabled later.
OPENCODE_GO_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EXPLABS_API_KEY=
EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1
# Optional non-secret organization id for Experiential usage rollups.
# EXPLABS_ORG_ID=
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# --- Supabase authentication and local authorization (Google-only) ---
# SUPABASE_URL and the publishable key are browser-safe but environment-specific.
# SUPABASE_SECRET_KEY is server-only and must never reach HTML/JavaScript/logs.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Comma-separated normalized Google emails. Keep real values only in .env or
# the deployment secret store; the application persists roles server-side.
# In auth admission_mode = "open" this is optional and is ignored for normal
# users; in "allowlist" mode it is the complete normal-user admission list.
ORYXENAI_ADMIN_BOOTSTRAP_EMAILS=
ORYXENAI_ALLOWED_USER_EMAILS=

# Legacy/deferred provider credential; not part of the selected auth design.
FIREBASE_ADMIN_CREDENTIAL_JSON=

# --- Optional local port override (not a secret; safe to leave blank) ---
# Native mode normally connects to PostgreSQL using config/app.native.toml's
# [database] host/port (127.0.0.1:5432). If another local PostgreSQL install
# already owns 5432 on your machine, set these instead of editing the
# committed TOML -- they take priority over it for every native script
# (align-db/migrate/api/worker/dev). Leave both blank to use the plain
# default. See README.md's Troubleshooting section for the full recipe.
DB_HOST_OVERRIDE=
DB_PORT_OVERRIDE=

# --- Azure deployment coordinates (non-secret) ---
# These values are consumed by the Compose-managed Caddy service and the
# deployment wizard. Keep real values on the VM in .env.
APP_HOST=app.example.com
PREVIEW_HOST=preview.example.com

# --- VM-local persistent storage (non-secret) ---
# The production Compose file bind-mounts every durable path below this root.
# Keep the root on the persistent VM disk, not in the repository checkout.
ORYXENAI_DATA_ROOT=/srv/oryxenai
# Keep backups outside the live data root so a storage archive never includes
# itself. Copy important backups off the VM as part of the recovery procedure.
ORYXENAI_BACKUP_DIR=/srv/oryxenai-backups
# doctor fails below the minimum and warns below the higher threshold.
ORYXENAI_STORAGE_MIN_FREE_GIB=10
ORYXENAI_STORAGE_WARN_FREE_GIB=20
# Operational policy values; the application also keeps its configured preview
# retention value in config/app.production.toml.
ORYXENAI_PREVIEW_RETENTION_DAYS=3
ORYXENAI_WORKSPACE_RETENTION_DAYS=7
ORYXENAI_CACHE_RETENTION_DAYS=30






