# ============================================================================
# OryxenAI secrets (TEMPLATE).
# Copy this file to ".env" and fill in real credential VALUES only.
# Never commit ".env". This file contains no real credentials.
#
# Non-secret application configuration lives in committed files:
#   config/app.toml      -> [app] and [database] settings
#   config/models.toml  -> provider-neutral model profiles
#
# Only SECRET VALUES belong here.
# ============================================================================

# PostgreSQL password for the application database user.
POSTGRES_PASSWORD=

# --- Optional provider/model API keys ---
# Active real model operations use the environment variable named by their
# profile's api_key_env. The committed default is Anthropic. The app, worker,
# and normal tests (deterministic mock model client) do not require a model key.
# Profiles in config/models.toml reference these by NAME via api_key_env.
# Keep provider keys available for profiles that may be enabled later.
OPENCODE_GO_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY1=
GEMINI_API_KEY2=
GEMINI_API_KEY3=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
# Cloudflare R2 artifact storage (endpoint/bucket live in config/app.toml).
CLOUDFLARE_API_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
FIREBASE_ADMIN_CREDENTIAL_JSON=









