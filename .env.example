# ============================================================================
# OryxenAI environment configuration (TEMPLATE).
# Copy this file to ".env" and fill in real values. Never commit ".env".
# This file contains ONLY safe placeholders, no real credentials.
# ============================================================================

# ---- Application ----
APP_NAME=OryxenAI
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Enable the developer testing UI served by FastAPI (true/false).
ENABLE_DEV_UI=true

# ---- PostgreSQL ----
# Either set DATABASE_URL, or the individual POSTGRES_* variables below.
# When DATABASE_URL is unset, the connection is composed from POSTGRES_* values.
DATABASE_URL=postgresql+asyncpg://oryxen:oryxen@localhost:5432/oryxenai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oryxenai
POSTGRES_USER=oryxen
POSTGRES_PASSWORD=oryxen

# ---- Model provider (optional during the scaffold phase) ----
# The scaffold does not call any model. These are read by the settings object
# for future use by the provider-neutral ModelClient and remain optional now.
MODEL_BASE_URL=
MODEL_NAME=
# Optional. The application starts without a model credential in this phase.
MODEL_API_KEY=