<a class="skip-link" href="#main">Skip to content</a>
<div class="scroll-progress" aria-hidden="true"></div>
<header class="site-header">
  <a class="wordmark" href="#home" aria-label="{{ d.home_label }}"><span class="wordmark-mark">{{ d.monogram }}<span class="wordmark-dot">.</span></span><span class="wordmark-name" data-field="hero.name">{{ c.hero.name }}</span></a>
  <nav class="site-nav" aria-label="Main navigation"><a href="#home">Home</a><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></nav>
  <a class="header-cta" href="#contact">Let's talk <span aria-hidden="true">↗</span></a>
</header>
<main id="main">
<article class="route-view" id="home" data-view data-title="{{ c.metadata.title }}">
  <section class="hero section-pad" aria-labelledby="hero-title">
    <div class="hero-copy"><p class="eyebrow" data-field="hero.eyebrow_primary">{{ c.hero.eyebrow_primary }}</p><h1 id="hero-title"><span data-field="hero.headline_prefix">{{ c.hero.headline_prefix }}</span> <em data-field="hero.headline_emphasis">{{ c.hero.headline_emphasis }}</em></h1><p class="hero-lede" data-field="hero.intro">{{ c.hero.intro }}</p><div class="hero-actions"><a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↗</span></a><a class="text-link" href="#about">Get to know me <span aria-hidden="true">↗</span></a></div><div class="hero-foot"><span>01 / Introduction</span>{% if c.hero.location %}<span data-field="hero.location">{{ c.hero.location }}</span>{% endif %}</div></div>
    <div class="hero-visual"><div class="hero-core"><span data-field="hero.name">{{ c.hero.name }}</span><span class="core-arrow" aria-hidden="true">↗</span></div><div class="hero-float hero-float-top"><span class="mini-symbol" aria-hidden="true">✳</span><span data-field="hero.eyebrow_secondary">{{ c.hero.eyebrow_secondary }}</span></div><p class="visual-caption"><span>Fig. 01</span><span>Abstract artwork</span></p></div>
  </section>
  {% if c.marquee_keywords %}<div class="marquee" role="region" aria-label="Areas of practice"><ul class="marquee-track">{% for keyword in c.marquee_keywords %}<li data-field="marquee_keywords[{{ loop.index0 }}]">{{ keyword }}</li>{% endfor %}</ul></div>{% endif %}
  <section class="intro-band section-pad atlas-appear"><p class="section-kicker">The through line</p><p class="intro-statement" data-field="systems_practice.heading">{{ c.systems_practice.heading }}</p><div class="intro-side"><span class="asterisk" aria-hidden="true">✳</span><p data-field="systems_practice.intro">{{ c.systems_practice.intro }}</p></div></section>
  <section class="work-section section-pad" id="work" aria-labelledby="work-title"><div class="section-heading atlas-appear"><div><p class="section-kicker">01 / Selected work</p><h2 id="work-title">Selected <em>work.</em></h2></div><p>Projects and ideas shaped by this portfolio.</p></div>
    {% if c.atlas.projects %}<div class="project-list">{% for project in c.atlas.projects %}
      {% set case = project.problem and project.approach %}
      {% if case %}<a class="project-card atlas-appear" href="#case-{{ loop.index }}" aria-label="{{ project.title }} case study">{% elif project.external_url %}<a class="project-card atlas-appear" href="{{ project.external_url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ project.title }}">{% else %}<div class="project-card atlas-appear">{% endif %}
      <div class="project-art" data-art="{{ d.arts[loop.index0] }}" data-tone="{{ (loop.index0 % 4) + 1 }}" aria-hidden="true"><span class="art-corner">0{{ loop.index }} / {% if project.kind == 'illustrative' %}Illustrative concept{% else %}Selected project{% endif %}</span><span class="art-bottom">{{ project.title }}</span></div>
      <div class="project-info"><span class="project-number">0{{ loop.index }} — {% if project.kind == 'illustrative' %}Illustrative concept — not real client work{% else %}Project{% endif %}</span><div><h3 data-field="atlas.projects[{{ loop.index0 }}].title">{{ project.title }}</h3><p data-field="atlas.projects[{{ loop.index0 }}].summary">{{ project.summary }}</p></div><span class="project-arrow" aria-hidden="true">↗</span>{% if project.period %}<span class="project-meta" data-field="atlas.projects[{{ loop.index0 }}].period">{{ project.period }}</span>{% endif %}</div>
      {% if case or project.external_url %}</a>{% else %}</div>{% endif %}
    {% endfor %}</div>{% else %}<div class="work-empty atlas-appear"><div class="project-art" data-art="orbit" data-tone="1" aria-hidden="true"></div><div><p class="section-kicker">Work in progress</p><h3>Your story can grow here.</h3><p>Project details can be added whenever you're ready.</p></div></div>{% endif %}
  </section>
  {% if c.atlas.statistics %}<section class="impact-section section-pad atlas-appear"><div class="impact-head"><p class="section-kicker">02 / Measured moments</p><h2>Selected <em>results.</em></h2>{% if d.sample.statistics %}<p class="project-meta">Sample content — replace with your own details.</p>{% endif %}</div><div class="impact-grid">{% for stat in c.atlas.statistics %}<div><strong data-field="atlas.statistics[{{ loop.index0 }}].value">{{ stat.value }}</strong><p data-field="atlas.statistics[{{ loop.index0 }}].label">{{ stat.label }}</p></div>{% endfor %}</div></section>{% endif %}
  <section class="approach-section section-pad atlas-appear"><div><p class="section-kicker">03 / How I work</p><h2>Ways of <em>working.</em></h2></div><div class="approach-list">{% for pillar in c.systems_practice.pillars %}<div><span>0{{ loop.index }}</span><h3 data-field="systems_practice.pillars[{{ loop.index0 }}].title">{{ pillar.title }}</h3><p data-field="systems_practice.pillars[{{ loop.index0 }}].description">{{ pillar.description }}</p></div>{% endfor %}</div></section>
  <section class="contact-section section-pad" id="contact"><p class="section-kicker">04 / Let's connect</p><div class="contact-grid"><h2 data-field="connect.heading">{{ c.connect.heading }}</h2><div><p data-field="connect.intro">{{ c.connect.intro }}</p>{% for destination in c.connect.destinations %}<a class="button button-light" href="{{ destination.url }}" {% if destination.url.startswith('http') %}target="_blank" rel="noopener noreferrer"{% endif %}><span data-field="connect.destinations[{{ loop.index0 }}].label">{{ destination.label }}</span> <span aria-hidden="true">↗</span></a>{% endfor %}</div></div></section>
</article>
<article class="route-view inner-page" id="about" data-view data-title="About — {{ c.hero.name }}">
  <section class="page-hero section-pad"><p class="section-kicker">02 / About</p><div class="page-hero-grid"><h1 data-field="atlas.about_heading">{{ c.atlas.about_heading }}</h1><div><figure class="portrait" data-initials="{{ d.monogram }}"></figure><p class="page-lede" data-field="atlas.about_intro">{{ c.atlas.about_intro }}</p><a class="text-link" href="#contact">Get in touch <span aria-hidden="true">↗</span></a></div></div></section>
  {% if c.atlas.about_quote %}<section class="about-quote section-pad atlas-appear"><span class="asterisk" aria-hidden="true">✳</span><blockquote data-field="atlas.about_quote">{{ c.atlas.about_quote }}</blockquote></section>{% endif %}
  {% if c.atlas.experience %}<section class="experience section-pad"><div class="section-heading"><div><p class="section-kicker">01 / Journey</p><h2>Experience.</h2>{% if d.sample.experience %}<p class="project-meta">Sample content — replace with your own details.</p>{% endif %}</div></div><div class="timeline">{% for row in c.atlas.experience %}<div class="timeline-row atlas-appear"><span data-field="atlas.experience[{{ loop.index0 }}].dates">{{ row.dates }}</span><div><h3 data-field="atlas.experience[{{ loop.index0 }}].role">{{ row.role }}</h3><p data-field="atlas.experience[{{ loop.index0 }}].organization">{{ row.organization }}</p><p data-field="atlas.experience[{{ loop.index0 }}].description">{{ row.description }}</p></div><b aria-hidden="true">0{{ loop.index }}</b></div>{% endfor %}</div></section>{% endif %}
  <section class="capabilities section-pad atlas-appear"><div><p class="section-kicker">02 / Practice</p><h2 data-field="technical_capabilities.heading">{{ c.technical_capabilities.heading }}</h2></div><div class="capability-grid">{% for group in c.technical_capabilities.groups %}<div><span>0{{ loop.index }}</span><h3 data-field="technical_capabilities.groups[{{ loop.index0 }}].heading">{{ group.heading }}</h3><p>{{ group['items'] | join(' · ') }}</p></div>{% endfor %}</div></section>
  {% if c.atlas.education %}<section class="education section-pad atlas-appear"><div><p class="section-kicker">03 / Foundation</p><h2>Education.</h2>{% if d.sample.education %}<p class="project-meta">Sample content — replace with your own details.</p>{% endif %}</div><div>{% for row in c.atlas.education %}<div class="education-row"><strong data-field="atlas.education[{{ loop.index0 }}].credential">{{ row.credential }}</strong><span data-field="atlas.education[{{ loop.index0 }}].institution">{{ row.institution }}</span><span data-field="atlas.education[{{ loop.index0 }}].dates">{{ row.dates }}</span></div>{% endfor %}</div></section>{% endif %}
  <section class="page-next section-pad"><p class="section-kicker">Next / Selected work</p><a href="#work">See the work <span aria-hidden="true">↗</span></a></section>
</article>
{% for project in c.atlas.projects %}{% if project.problem and project.approach %}
<article class="route-view inner-page case-page" id="case-{{ loop.index }}" data-view data-title="{{ project.title }} — {{ c.hero.name }}"><section class="case-hero section-pad"><a class="back-link" href="#work">← All work</a><p class="section-kicker">Case 0{{ loop.index }}{% if project.kind == 'illustrative' %} / Illustrative concept — not real client work{% endif %}</p><h1 data-field="atlas.projects[{{ loop.index0 }}].title">{{ project.title }}</h1><div class="case-intro"><p data-field="atlas.projects[{{ loop.index0 }}].summary">{{ project.summary }}</p>{% if project.role %}<dl><div><dt>Role</dt><dd data-field="atlas.projects[{{ loop.index0 }}].role">{{ project.role }}</dd></div></dl>{% endif %}</div></section><section class="case-art-section section-pad"><div class="case-art-frame" data-art="{{ d.arts[loop.index0] }}" data-tone="{{ (loop.index0 % 4) + 1 }}" role="img" aria-label="Abstract artwork"><span class="art-corner">0{{ loop.index }} / Conceptual artwork</span></div><p class="visual-note">Conceptual artwork — illustrative, not a product screenshot.</p></section><section class="case-body section-pad"><div class="case-text atlas-appear"><span>01 / The opportunity</span><h2>Problem</h2><p data-field="atlas.projects[{{ loop.index0 }}].problem">{{ project.problem }}</p></div><div class="case-text atlas-appear"><span>02 / The approach</span><h2>Approach</h2><p data-field="atlas.projects[{{ loop.index0 }}].approach">{{ project.approach }}</p></div>{% if project.outcome %}<div class="case-result atlas-appear"><span>03 / Outcome</span><p data-field="atlas.projects[{{ loop.index0 }}].outcome">{{ project.outcome }}</p></div>{% endif %}</section><section class="page-next section-pad"><p class="section-kicker">Back / Selected work</p><a href="#work">Explore all work <span aria-hidden="true">↗</span></a></section></article>
{% endif %}{% endfor %}
</main>
<footer class="site-footer section-pad"><div><a class="footer-mark" href="#home">{{ d.monogram }}<span>.</span></a><p data-field="hero.name">{{ c.hero.name }}</p></div><div class="footer-links"><a href="#work">Work</a><a href="#about">About</a><a href="#contact">Contact</a></div><span class="footer-top"><a href="#home">Back to top ↑</a></span></footer>
<span class="sr-only" id="route-announcer" role="status" aria-live="polite"></span>
