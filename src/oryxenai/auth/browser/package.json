{
  "name": "oryxenai-auth-browser",
  "private": true,
  "version": "0.1.0",
  "description": "Pinned self-hosted Supabase browser client for OryxenAI auth",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"const { pathToFileURL } = require('node:url'); import(pathToFileURL(require('node:path').join(process.env.npm_config_local_prefix, 'build.mjs')).href)\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
