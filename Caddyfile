# Compose-managed Caddy configuration.
# APP_HOST and PREVIEW_HOST are supplied by the VM-local .env file.
# Caddy reaches the application over the Compose network, so host port
# publishes for the application and preview remain unnecessary.
#
# Neither upstream service sets HSTS itself (the app layer only adds a CSP
# to its own auth pages), so the edge is the one place that can guarantee it
# for every response on both hostnames.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$APP_HOST} {
	import security_headers
	reverse_proxy app:8000
}

{$PREVIEW_HOST} {
	import security_headers
	reverse_proxy preview-gateway:4174
}
