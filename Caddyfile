# Compose-managed Caddy configuration.
# APP_HOST is supplied by the VM-local .env file.
# Caddy reaches the application over the Compose network, so the app needs no
# host port publish.
#
# The app layer only adds a CSP to its auth pages, so the edge is the one
# place that can guarantee HSTS for every response.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

{$APP_HOST} {
	import security_headers
	reverse_proxy app:8000
}
