# Compose-managed Caddy configuration.
# APP_HOST and PREVIEW_HOST are supplied by the VM-local .env file.
# Caddy reaches the application over the Compose network, so host port
# publishes for the application and preview remain unnecessary.

{$APP_HOST} {
	reverse_proxy app:8000
}

{$PREVIEW_HOST} {
	reverse_proxy preview-gateway:4174
}
